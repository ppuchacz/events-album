.PHONY: help install dev build preview lint

help:
	@echo "Dostępne komendy dla projektu frontend (React + Vite):"
	@echo "  make install  - Instalacja zależności npm"
	@echo "  make dev      - Uruchomienie serwera deweloperskiego Vite (port 5173)"
	@echo "  make build    - Zbudowanie produkcyjnej paczki aplikacji"
	@echo "  make preview  - Podgląd zbudowanej wersji produkcyjnej"
	@echo "  make lint     - Sprawdzenie typów TypeScript"

install:
	npm install

dev:
	npm run dev

build:
	npm run build

preview:
	npm run preview

lint:
	npm run lint
